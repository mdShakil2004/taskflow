{
  "info": {
    "name": "TaskFlow API",
    "description": "Demo flow: register -> create project -> create task -> assign task -> check job status -> view task. Uses collection variables so it imports and runs without manual edits.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "organizationId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "jobId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);",
              "pm.collectionVariables.set('organizationId', body.organization.id);",
              "pm.collectionVariables.set('userId', body.user.id);",
              "pm.test('registration succeeded', () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo-{{$randomInt}}@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"fullName\": \"Demo User\",\n  \"organizationName\": \"Demo Org {{$randomInt}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "2. Create Project",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('projectId', body.id);",
              "pm.test('project created', () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Organization-Id", "value": "{{organizationId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Project\",\n  \"description\": \"Created from the Postman demo flow\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/v1/projects", "host": ["{{baseUrl}}"], "path": ["api", "v1", "projects"] }
      }
    },
    {
      "name": "3. Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('taskId', body.id);",
              "pm.test('task created', () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Organization-Id", "value": "{{organizationId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Demo task\",\n  \"description\": \"Created from the Postman demo flow\",\n  \"priority\": \"high\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "projects", "{{projectId}}", "tasks"]
        }
      }
    },
    {
      "name": "4. Assign Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('jobId', body.jobId);",
              "pm.test('assignment created', () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Organization-Id", "value": "{{organizationId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}/assignments",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{taskId}}", "assignments"]
        }
      }
    },
    {
      "name": "5. Check Job Status",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Organization-Id", "value": "{{organizationId}}" }
        ],
        "url": { "raw": "{{baseUrl}}/jobs/{{jobId}}", "host": ["{{baseUrl}}"], "path": ["jobs", "{{jobId}}"] }
      }
    },
    {
      "name": "6. View Task",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Organization-Id", "value": "{{organizationId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{taskId}}"]
        }
      }
    },
    {
      "name": "7. Project Dashboard",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Organization-Id", "value": "{{organizationId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/projects/{{projectId}}/dashboard",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "projects", "{{projectId}}", "dashboard"]
        }
      }
    },
    {
      "name": "8. Login (existing user)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@nimbus.example\",\n  \"password\": \"DemoPass123!\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "9. Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
      }
    },
    {
      "name": "10. Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
      }
    }
  ]
}
